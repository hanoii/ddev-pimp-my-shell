#!/bin/bash
#ddev-generated

# Autocomplete for `ddev upterm`, backed by upterm's own (cobra) completion engine
# (`upterm __complete`). DDEV passes the command line starting with the command
# name, so drop it. Each output line is `value<TAB>description` and the last
# one is a `:directive`, which DDEV has no use for.

shift
upterm __complete "$@" 2>/dev/null | grep -v '^:' | cut -f1
