#!/bin/bash
#ddev-generated

# Autocomplete for `ddev task`, backed by task's own completion engine
# (`task __complete`, task >= 3.54.0). DDEV passes the command line starting
# with the command name, so drop it. Each output line is `value<TAB>description`
# and the last one is a `:directive`, which DDEV has no use for.

shift
task __complete "$@" 2>/dev/null | grep -v '^:' | cut -f1
