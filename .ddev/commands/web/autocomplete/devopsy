#!/bin/bash
#ddev-generated

# Autocomplete for `ddev devopsy`, backed by devopsy's own completion engine
# (`devopsy --complete`). DDEV passes the command line starting with the
# command name, so drop it. Each output line is `value<TAB>description<TAB>group`
# and the last one is a `:directive`, which DDEV has no use for.

shift
devopsy --complete "$@" 2>/dev/null | grep -v '^:' | cut -f1
